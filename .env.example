# Copia este archivo a `.env` y completa los valores. `.env` no se sube a git.

# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=changeme-genera-una-clave-real-para-produccion
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=tudominio.com,tuapp.onrender.com

# ── Base de datos ───────────────────────────────────────────────────────
# Cadena de conexión estándar. Motores soportados: postgres/postgresql, mysql, sqlite.
# Si DATABASE_URL queda vacía, se usa sqlite local (db.sqlite3) — solo para desarrollo.
# Ejemplos:
#   Postgres:  postgresql://usuario:password@host:5432/nombre_bd?sslmode=require
#   MySQL:     mysql://usuario:password@host:3306/nombre_bd
#   Sqlite:    sqlite:///db.sqlite3
DATABASE_URL=

# Solo aplica si usas Supabase Postgres con el host directo (db.<ref>.supabase.co):
# la app lo reescribe automáticamente al connection pooler IPv4 usando estas dos
# variables (ver hechoshub/db_config.py). Con cualquier otro proveedor (Neon, RDS,
# tu propio Postgres, Supabase vía pooler, etc.) no hacen nada — se pueden dejar vacías.
SUPABASE_POOLER_REGION=
SUPABASE_POOLER_CLUSTER=

# ── Almacenamiento de archivos subidos (avatars, entregas, recursos) ──────
# Opcional. Si dejas estas 4 vacías, los archivos se guardan en disco local (media/).
# Sirve para desarrollo, pero en un host con disco efímero (Render, Railway free, etc.)
# los archivos subidos se PIERDEN en cada redeploy o reinicio del servicio.
# Cualquier proveedor S3-compatible funciona: Supabase Storage, AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO propio, etc.
# Ver README → "Almacenamiento de archivos" para instrucciones paso a paso.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION_NAME=
