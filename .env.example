DJANGO_SECRET_KEY=changeme-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Supabase (API / cliente JS; opcional para el backend Django) ---
# URL del proyecto: https://<project_ref>.supabase.co
SUPABASE_URL=https://rwajorebhxokoahiqnws.supabase.co
# Clave publicable (anon / publishable). No es la contraseña de Postgres.
SUPABASE_ANON_KEY=tu_clave_sb_publishable_o_anon_aqui

# --- Base de datos Django ---
# Opcion 1: SQLite local (por defecto si no hay DATABASE_URL)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Opcion 2: variables sueltas PostgreSQL
# DB_ENGINE=postgres
# DB_NAME=hechoshub
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Opcion 3: DATABASE_URL (recomendado con Supabase)
#
# La conexion DIRECTA (db.<ref>.supabase.co:5432) suele ser solo IPv6.
# Si ves "failed to resolve host" o no conecta, usa el Session pooler desde el panel.
#
# Codifica la contraseña de la base de datos si tiene caracteres especiales (+ * , @ # etc.):
#   python -c "from urllib.parse import quote; print(quote('TU_PASSWORD', safe=''))"
#
# Session pooler (IPv4, recomendado para Mac/redes sin IPv6). Copia la URI exacta desde:
#   Dashboard → Connect → Session pooler
# Formato tipico:
#   postgresql://postgres.rwajorebhxokoahiqnws:PASSWORD_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Transaction pooler (mismo host db.<ref> que directo, puerto 6543). Django ajusta cursores automaticamente.
#   postgresql://postgres:PASSWORD_ENCODED@db.rwajorebhxokoahiqnws.supabase.co:6543/postgres?sslmode=require
#
# DATABASE_URL=postgresql://postgres:PASSWORD_ENCODED@db.rwajorebhxokoahiqnws.supabase.co:5432/postgres?sslmode=require
